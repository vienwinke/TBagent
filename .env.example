# ⚠️ 这是模板：模型名/密钥/密码都需按你的实际环境填写。
#    直接 cp .env.example .env 会导致"模型名不对(400)、密码是 CHANGE_ME" —— 实测踩过。
# ============================================================
# 大模型接入（OpenAI 兼容协议）
# 当前：Command Code Provider API（同时兼容 OpenAI / Anthropic 格式）
#   1) 到 https://commandcode.ai/studio/provider 生成 API Key（与 CLI 同一个 key）
#   2) 填入下面 LLM_API_KEY
#   3) 模型名：跑 `python scripts/probe_endpoint.py` 从 /models 列表里挑
# 计费：Provider 套餐 $15/月 + $1.01 手续费，之后按 API 费率无加价按量计费，额度不过期
# ============================================================
LLM_API_KEY=your-command-code-key
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_MODEL_CHEAP=Qwen/Qwen3.8-Flash

# 单价（元/百万 token），仅用于本地成本估算；实际以 Command Code 用量页为准
LLM_PRICE_IN=2.0
LLM_PRICE_OUT=9.0
# 便宜档单价：路由分类 / 结果转述 / 追问建议走 LLM_MODEL_CHEAP
# 留空 = 按主档单价估算（偏保守，不会低估）；填上后成本面板与审计金额会按模型分别计价
LLM_PRICE_IN_CHEAP=
LLM_PRICE_OUT_CHEAP=
# 命中前缀缓存的输入单价：实测 provider 会缓存公共前缀（跨问题命中 75~95%），
# 缓存读取通常远低于正常输入价；留空 = 按全价计（偏保守的上界，不会低估成本）
LLM_PRICE_IN_CACHED=
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ---- 备选平台（只改这 2~3 行即可切换，代码无需改动）----
# DeepSeek 直连（更便宜）
#   LLM_BASE_URL=https://api.deepseek.com                     LLM_MODEL=deepseek-chat
# 智谱 GLM（glm-4-flash 免费）
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4         LLM_MODEL=glm-4-flash
# 通义千问（有免费额度）
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-turbo
# Kimi
#   LLM_BASE_URL=https://api.moonshot.cn/v1                   LLM_MODEL=moonshot-v1-8k

# ============================================================
# 数据库（只读连接；拆分字段避免密码特殊字符破坏 URL）
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=CHANGE_ME
DB_NAME=treatbord

# ============================================================
# 护栏参数
# ============================================================
SQL_MAX_ROWS=200
SQL_TIMEOUT_MS=3000
SQL_EXPLAIN_ROW_LIMIT=100000
SCHEMA_TOP_K=5
EMBED_BACKEND=bm25
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_TTL_SEC=600
SUMMARY_TEMPLATE_FIRST=true
SCHEMA_MAX_COLUMNS=0
SCHEMA_DESC_MAX=0
# 语义层范围判定是否启用 LLM 兜底（默认 false）：规则命中即返回、结论可复现；
# 开启后仅在"规则一条都没命中"时问模型，提高召回但引入采样不确定性
SCOPE_LLM_FALLBACK=false

# ===== AI 边车（sidecar/app.py，仅服务化用）=====
# 内部 JWT 密钥（HS256）：P1 实现鉴权后必填；**未配置时 /v1/ai/chat 一律 503**
SIDECAR_JWT_SECRET=
# 本地联调用的开发身份（格式 user_id:ROLE，如 7:USER）。生产环境务必留空！
SIDECAR_DEV_PRINCIPAL=
SIDECAR_HOST=127.0.0.1
SIDECAR_PORT=8080
