# ===== 大模型平台（OpenAI 兼容）=====
# 推荐 DeepSeek（注册简单、有免费额度）；换平台只改 BASE_URL 与 MODEL
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 低价档（评估/批量跑分时可切，省成本）
LLM_MODEL_CHEAP=deepseek-chat

# ===== 只读数据库（三层护栏第 2 层：沙箱）=====
# 建议单独建只读账号（见 sql/readonly_user.sql）
DB_READONLY_URL=mysql+pymysql://agent_ro:CHANGE_ME@127.0.0.1:3306/treatbord?charset=utf8mb4
# 兜底：若无法建只读账号，用 app_user + 会话级 READ ONLY（代码里会强制 SET SESSION TRANSACTION READ ONLY + max_execution_time）
DB_FALLBACK_URL=mysql+pymysql://app_user:CHANGE_ME@127.0.0.1:3306/treatbord?charset=utf8mb4

# ===== 护栏参数 =====
SQL_MAX_ROWS=200            # 结果行数上限
SQL_TIMEOUT_MS=3000         # 单条 SQL 超时
SQL_EXPLAIN_ROW_LIMIT=100000 # EXPLAIN 预估扫描行数阈值，超过直接拒绝
SCHEMA_TOP_K=5              # 注入 prompt 的相关表数量
